# ===== Ieumi backend environment =====
# Copy this file to `.env` and fill in your own keys.
# NEVER commit the real .env (it is gitignored).

# --- Postgres : centers, accounts, rosters, priorities, requests (REQUIRED) ---
# Any Postgres works: a local server, or a free hosted one (Neon, Supabase, Railway).
# Without this the kiosk still talks, but login and both dashboards will not work.
DATABASE_URL=
# TLS. Leave blank: the certificate is verified for a remote database, and TLS is
# skipped for localhost. `off` = no TLS (a plain local server). `no-verify` = TLS
# without checking the certificate — self-signed servers only, never production.
DB_SSL=
# How long a dashboard login lasts, in hours (default 12).
SESSION_HOURS=
# Set to `on` when serving over HTTPS behind a proxy that does not set
# x-forwarded-proto, so the session cookie is marked Secure.
COOKIE_SECURE=

# --- First-run seed accounts (optional) ---
# `npm run seed` generates random passwords and prints them once. Set these to
# choose your own instead. They are only read when the account does not exist yet.
SEED_MASTER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# --- Claude (Anthropic) : conversation ---
ANTHROPIC_API_KEY=
# Model for the kiosk conversation. Leave blank for the default (claude-sonnet-5).
# Measured on the real prompt, time to the first spoken sound:
#   claude-sonnet-5   ~2.5-2.9s   $2/$10 per MTok   — default; best balance
#   claude-haiku-4-5  ~2.4s       $1/$5             — cheapest and marginally faster,
#                                                     slightly clumsier Korean
#   claude-sonnet-4-6 ~2.6-3.1s   $3/$15            — the previous default; superseded
# A single centre can override this from the dashboard (center_settings.chat_model).
CLAUDE_MODEL=

# --- NAVER CLOVA : Text-to-Speech (voice output) ---
CLOVA_API_KEY_ID=
CLOVA_API_KEY=
CLOVA_SPEAKER=vian
CLOVA_SPEED=0

# --- NAVER Cloud SENS : SMS sending (option A) ---
NCP_SENS_ACCESS_KEY=
NCP_SENS_SECRET_KEY=
NCP_SENS_SERVICE_ID=
SMS_FROM_NUMBER=

# --- Aligo : SMS sending (option B) ---
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# --- data.go.kr : public senior-job data ---
DATAGO_KEY=

# ── 한국 중계 (선택) — Korea fetch relay
# 한국 공공기관 사이트 상당수가 해외 IP 를 거부합니다. 앱을 한국 밖에 두면서도
# 링크를 읽으려면, 한국에 있는 기기에서 korea-relay.js 를 돌리고 그 주소를 여기에.
# 한국에서 직접 돌린다면 비워 두십시오 — 중계는 필요 없습니다.
#
# Korean government sites refuse foreign IPs. To host the app anywhere while
# still reading those pages, run korea-relay.js on a machine in Korea and put its
# address here. Leave blank when the app itself runs in Korea.
#   한국 기기에서:  KOREA_RELAY_TOKEN=... node korea-relay.js
#                  cloudflared tunnel --url http://localhost:8799
# KOREA_RELAY_URL=https://your-tunnel.trycloudflare.com
# KOREA_RELAY_TOKEN=a-long-random-string-shared-with-the-relay

# ── 자바스크립트로 그리는 페이지 (선택) — headless rendering
# 링크 중 일부는 그냥 받아오면 빈 껍데기입니다 (복지로는 글자 세 개). 크롬이
# 깔려 있으면 자동으로 브라우저로 한 번 더 열어 봅니다 — 껍데기일 때만.
# 크롬을 못 찾으면 그냥 건너뜁니다. 경로를 직접 주려면 CHROME_PATH.
#
# Some pages are an empty shell until JavaScript fills them in. When Chrome or
# Edge is present, those are re-opened in a headless browser — only the empty
# ones, since 37 of 52 links need no such thing. Skipped silently if absent.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# RENDER_THIN_CHARS=400      # 이보다 글이 적으면 껍데기로 봅니다
# RENDER_BUDGET_MS=9000      # 자바스크립트가 돌기를 기다리는 시간
