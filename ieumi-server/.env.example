# ===== Ieumi backend environment =====
# Copy this file to `.env` and fill in your own keys.
# NEVER commit the real .env (it is gitignored).

# --- Claude (Anthropic) : conversation ---
ANTHROPIC_API_KEY=

# --- NAVER CLOVA : Text-to-Speech (voice output) ---
CLOVA_API_KEY_ID=
CLOVA_API_KEY=
CLOVA_SPEAKER=vian
CLOVA_SPEED=0

# --- NAVER Cloud SENS : SMS sending (option A) ---
NCP_SENS_ACCESS_KEY=
NCP_SENS_SECRET_KEY=
NCP_SENS_SERVICE_ID=
SMS_FROM_NUMBER=

# --- Aligo : SMS sending (option B) ---
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# --- data.go.kr : public senior-job data ---
DATAGO_KEY=
